#replacewith
				if (isOfficerInShip(GetCharacter(cn), true))
				{
					// Professional officers learn their own shipboard speciality at the
					// player's full base XP rate. SharedExperience continues to govern
					// the officer's share of unrelated skills.
					bool bProfessionalSkill = false;

					switch (_skill)
					{
						case SKILL_SAILING:
							if (CheckAttribute(pchar, "Fellows.Passengers.navigator") && cn == sti(pchar.Fellows.Passengers.navigator))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_ACCURACY:
							if (CheckAttribute(pchar, "Fellows.Passengers.cannoner") && cn == sti(pchar.Fellows.Passengers.cannoner))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_CANNONS:
							if (CheckAttribute(pchar, "Fellows.Passengers.cannoner") && cn == sti(pchar.Fellows.Passengers.cannoner))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_GRAPPLING:
							if (CheckAttribute(pchar, "Fellows.Passengers.boatswain") && cn == sti(pchar.Fellows.Passengers.boatswain))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_DEFENCE:
							if (CheckAttribute(pchar, "Fellows.Passengers.doctor") && cn == sti(pchar.Fellows.Passengers.doctor))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_REPAIR:
							if (CheckAttribute(pchar, "Fellows.Passengers.carpenter") && cn == sti(pchar.Fellows.Passengers.carpenter))
							{
								bProfessionalSkill = true;
							}
						break;

						case SKILL_COMMERCE:
							if (CheckAttribute(pchar, "Fellows.Passengers.treasurer") && cn == sti(pchar.Fellows.Passengers.treasurer))
							{
								bProfessionalSkill = true;
							}
						break;
					}

					if (bProfessionalSkill)
					{
						div = 1.0;
					}

					float fOfficerXP = iBonus * _addValue / div;

					// Minimal proof-of-operation logging:
					// only sizeable XP awards to the officer responsible for that skill.
					if (bProfessionalSkill)
					{
						if (_addValue >= 10.0)
						{
							trace("PROFESSIONAL_OFFICER_XP officer=" + characters[cn].id + " skill=" + _skill + " awarded=" + FloatToString(fOfficerXP, 2));
						}
					}

					AddCharacterExpToSkill(GetCharacter(cn), _skill, fOfficerXP);
				}
				else
				{
					AddCharacterExpToSkill(GetCharacter(cn), _skill, iBonus * _addValue / div);
				}
#endreplace
